generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  podeAtribuirParaOutros Boolean @default(false)
  podeConvidarColaboradores Boolean @default(false)

  // Relações independentes
  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  cargoId   String?
  cargo     Cargo?   @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  perfilId  String?
  perfil    Profile? @relation(fields: [perfilId], references: [id], onDelete: SetNull)

  tarefasCriadas       Task[] @relation("TaskCreator")
  tarefasResponsaveis  Task[] @relation("TaskResponsible")
  anexosEnviados       TaskAttachment[] @relation("TaskAttachmentUploader")
  agendasCriadas       MeetingAgenda[] @relation("MeetingAgendaCreator")
  participacoesReunioes MeetingParticipant[] @relation("MeetingParticipantUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([perfilId])
  @@index([unidadeId])
  @@index([cargoId])
  @@map("usuarios")
}

model Profile {
  id          String              @id @default(cuid())
  nome        String              @unique
  descricao   String?
  ativo       Boolean             @default(true)
  administradorTotal Boolean      @default(false)
  usuarios    User[]
  permissoes  ProfilePermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("perfis")
}

model Module {
  id        String     @id @default(cuid())
  nome      String
  slug      String     @unique
  ordem     Int        @default(0)
  recursos  Resource[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("modulos")
}

model Resource {
  id         String              @id @default(cuid())
  nome       String
  slug       String
  moduleId   String
  modulo     Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permissoes ProfilePermission[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@map("recursos")
}

model ProfilePermission {
  id          String   @id @default(cuid())
  profileId   String
  recursoId   String
  perfil      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  recurso     Resource @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  verMenu     Boolean  @default(false)
  visualizar  Boolean  @default(false)
  criar       Boolean  @default(false)
  editar      Boolean  @default(false)
  excluir     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([profileId, recursoId])
  @@index([recursoId])
  @@map("permissoes_perfil")
}

model Unidade {
  id        String   @id @default(cuid())
  nome      String
  sigla     String   @unique
  ativo     Boolean  @default(true)
  usuarios  User[]
  tarefas   Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unidades")
}

model Category {
  id        String   @id @default(cuid())
  sigla     String   @unique
  nome      String
  cor       String
  ativa     Boolean  @default(true)
  tarefas   Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativa, nome])
  @@map("categorias")
}

model Task {
  id                    String    @id @default(cuid())
  numero                Int       @unique @default(autoincrement())
  codigo                String?   @unique
  titulo                String
  descricao             String?   @db.Text
  notasImportantes      String?   @db.Text
  privada               Boolean   @default(false)
  status                String    @default("NAO_INICIADO")
  prioridade            String    @default("MEDIA")
  categoria             String?
  categoriaId           String?
  category              Category? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  progresso             Int       @default(0)
  prazo                 DateTime?
  dataTarefa            DateTime  @default(now())
  responsavelId         String?
  responsavel           User?     @relation("TaskResponsible", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadorId             String
  criador               User      @relation("TaskCreator", fields: [criadorId], references: [id], onDelete: Restrict)
  unidadeId             String?
  unidade               Unidade?  @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  unidadesCompartilhadas String[] @default([])
  colaboradoresIds      String[]  @default([])
  anexos                TaskAttachment[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([categoria])
  @@index([categoriaId])
  @@index([responsavelId])
  @@index([unidadeId])
  @@index([criadorId])
  @@index([createdAt])
  @@map("tarefas")
}

model TaskAttachment {
  id          String   @id @default(cuid())
  nome        String
  nomeOriginal String
  url         String
  mimeType    String?
  tamanho     Int?
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  enviadoPorId String?
  enviadoPor  User?    @relation("TaskAttachmentUploader", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([enviadoPorId])
  @@map("anexos_tarefas")
}

model MeetingAgenda {
  id           String              @id @default(cuid())
  titulo       String
  dataHora     DateTime
  localOuLink  String?
  privada      Boolean             @default(false)
  pauta        Json?
  status       String              @default("AGENDADA")
  criadorId    String
  criador      User                @relation("MeetingAgendaCreator", fields: [criadorId], references: [id], onDelete: Restrict)
  participantes MeetingParticipant[]
  anexos       MeetingAttachment[]
  sumulaId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([dataHora])
  @@index([status, dataHora])
  @@index([criadorId])
  @@map("agendas_reunioes")
}

model MeetingParticipant {
  id                String        @id @default(cuid())
  agendaId          String
  agenda            MeetingAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  tipo              String        @default("INTERNO")
  userId            String?
  usuario           User?         @relation("MeetingParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  nome              String
  email             String
  confirmacao       String        @default("PENDENTE")
  tokenConfirmacao String        @unique @default(cuid())
  createdAt         DateTime      @default(now())

  @@index([agendaId])
  @@index([userId])
  @@map("participantes_reunioes")
}

model MeetingAttachment {
  id        String        @id @default(cuid())
  agendaId  String
  agenda    MeetingAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  nome      String
  url       String
  tamanho   Int?
  mimeType  String?
  createdAt DateTime      @default(now())

  @@index([agendaId, createdAt])
  @@map("anexos_reunioes")
}

model Cargo {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  usuarios  User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cargos")
}