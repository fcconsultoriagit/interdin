generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)

  // Relações independentes
  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  cargoId   String?
  cargo     Cargo?   @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  perfilId  String?
  perfil    Profile? @relation(fields: [perfilId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([perfilId])
  @@index([unidadeId])
  @@index([cargoId])
  @@map("usuarios")
}

model Profile {
  id          String              @id @default(cuid())
  nome        String              @unique
  descricao   String?
  ativo       Boolean             @default(true)
  administradorTotal Boolean      @default(false)
  usuarios    User[]
  permissoes  ProfilePermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("perfis")
}

model Module {
  id        String     @id @default(cuid())
  nome      String
  slug      String     @unique
  ordem     Int        @default(0)
  recursos  Resource[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("modulos")
}

model Resource {
  id         String              @id @default(cuid())
  nome       String
  slug       String
  moduleId   String
  modulo     Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permissoes ProfilePermission[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@map("recursos")
}

model ProfilePermission {
  id          String   @id @default(cuid())
  profileId   String
  recursoId   String
  perfil      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  recurso     Resource @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  verMenu     Boolean  @default(false)
  visualizar  Boolean  @default(false)
  criar       Boolean  @default(false)
  editar      Boolean  @default(false)
  excluir     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([profileId, recursoId])
  @@index([recursoId])
  @@map("permissoes_perfil")
}

model Unidade {
  id        String   @id @default(cuid())
  nome      String
  sigla     String   @unique
  ativo     Boolean  @default(true)
  usuarios  User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unidades")
}

model Cargo {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  usuarios  User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cargos")
}